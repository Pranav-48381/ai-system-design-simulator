# ==============================================================================
# AI System Design Interview Simulator - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local development setup.
# In production, ensure sensitive keys (SECRET_KEY, API keys) are injected securely.

# ------------------------------------------------------------------------------
# Application Environment & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="AI System Design Interview Simulator"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Async with asyncpg)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=system_design_interview
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/system_design_interview
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: openai, anthropic, google
DEFAULT_LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google Gemini Settings
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Shared LLM Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# LangGraph Workflow & Interview Session Settings
# ------------------------------------------------------------------------------
# Checkpointer backend: "memory" for local dev/testing, "postgres" for persistent state
LANGGRAPH_CHECKPOINTER=memory
DEFAULT_INTERVIEWER_PERSONA=collaborative_senior_staff
MAX_TURNS_PER_STAGE=8
MAX_TOTAL_INTERVIEW_TURNS=40
STAGE_TIME_LIMIT_MINUTES=10

# ------------------------------------------------------------------------------
# WebSocket Streaming & Real-Time Connection
# ------------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MESSAGE_RATE_LIMIT_PER_MINUTE=60
STREAMING_CHUNK_DELAY_MS=0
